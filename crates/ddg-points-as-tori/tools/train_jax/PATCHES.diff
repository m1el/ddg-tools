+# --- PAT-JAX patch (ddg-tools runs_tmp/pat-train-jax): periodic checkpoints, resume, progress lines. ---
+# Nothing below changes the training math, data order, RNG keys or hyperparameters.
+PAT_RESUME_DIR = os.environ.get('PAT_RESUME_DIR', 'checkpoints/')
+PAT_CKPT_SECONDS = float(os.environ.get('PAT_CKPT_SECONDS', '900'))
+PAT_LOG_EVERY = int(os.environ.get('PAT_LOG_EVERY', '50'))
+PAT_MAX_STEPS = int(os.environ.get('PAT_MAX_STEPS', '0'))  # > 0: checkpoint and stop the phase (tests only)
+PAT_CURRICULUM = []  # [(final_save_filepath, n_steps), ...], set by the driver (global step and ETA)
+PAT_COMPILES = {'n': 0, 's': 0.0, 'hits': 0}  # compile counter, maintained by the driver's jax.monitoring listener
+
+
+class PatStopPhase(Exception):
+	pass
+
+
+def _pat_flatten(state, prefix):
+	out = {}
+	for path, x in jax.tree_util.tree_flatten_with_path(state)[0]:
+		k = jax.tree_util.keystr(path)
+		if jax.dtypes.issubdtype(x.dtype, jax.dtypes.prng_key):
+			out[prefix + 'key:' + k] = np.asarray(jax.random.key_data(x))
+		else:
+			out[prefix + 'arr:' + k] = np.asarray(x)
+	return out
+
+
+def _pat_restore(obj, saved, prefix):
+	leaves, treedef = jax.tree_util.tree_flatten_with_path(nnx.state(obj))
+	new = []
+	for path, x in leaves:
+		k = jax.tree_util.keystr(path)
+		if jax.dtypes.issubdtype(x.dtype, jax.dtypes.prng_key):
+			new.append(jax.random.wrap_key_data(jnp.asarray(saved[prefix + 'key:' + k]), impl=jax.random.key_impl(x)))
+		else:
+			a = saved[prefix + 'arr:' + k]
+			assert a.shape == x.shape and a.dtype == x.dtype, f'checkpoint mismatch at {prefix}{k}'
+			new.append(jnp.asarray(a))
+	nnx.update(obj, jax.tree_util.tree_unflatten(treedef, [x for x in new]))
+
+
+def _pat_save(tag, model, optimizer, cursor, lists):
+	os.makedirs(PAT_RESUME_DIR, exist_ok=True)
+	d = {}
+	d.update(_pat_flatten(nnx.state(model), 'model/'))
+	d.update(_pat_flatten(nnx.state(optimizer), 'opt/'))
+	for k, v in cursor.items():
+		d['cursor/' + k] = np.asarray(v, dtype=np.int64)
+	for k, v in lists.items():
+		d['list/' + k] = np.asarray([np.asarray(x) for x in v], dtype=np.float32).reshape(-1)
+	path = os.path.join(PAT_RESUME_DIR, tag + '.npz')
+	tmp = os.path.join(PAT_RESUME_DIR, tag + '.tmp.npz')
+	np.savez(tmp, **d)
+	if os.path.exists(path):
+		os.replace(path, os.path.join(PAT_RESUME_DIR, tag + '.prev.npz'))
+	os.replace(tmp, path)
+	print(f'[PAT] checkpoint {path}: ' + ' '.join(f'{k}={v}' for k, v in cursor.items()), flush=True)
+
 
