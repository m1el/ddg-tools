import DdgProofs.Delaunay.Termination

/-!
# The fan of a vertex: at most one boundary halfedge leaves a vertex

On gluing data (`DdgProofs/Delaunay/Complex.lean`) the corners at a vertex are the class of the
equivalence relation generated by `Glued x y` (`x` glued, `y = next (twin x)`: `y` is the next
corner around the common vertex). `Glued` is the graph of an **injective partial map** of the
corners: it is defined exactly at the glued halfedges and `next ∘ twin` is injective. So every
vertex class is a single orbit of this partial map: a **cycle** (the fan closes up, an interior
vertex) or a **path** (an open fan). A path has exactly one last corner — the corner where the
map is undefined, i.e. a boundary halfedge `twin h = h` with tail at the vertex — and exactly one
first corner — the corner `x` with no predecessor, i.e. `prev x` is a boundary halfedge, whose
head is the vertex.

This is the combinatorial content of "a triangulated surface with boundary is a manifold with
boundary": the link of a vertex is a circle or an arc (Hatcher, *Algebraic Topology*, 2002,
Sec. 2.1 on Δ-complexes; Edelsbrunner, *Geometry and Topology for Mesh
Generation*, 2001, Sec. 3.2 on links of vertices of 2-manifolds with boundary). In the gluing
model it holds by construction, for any involution `twin`.

## Main results

* `Gluing.eq_of_isBoundary_of_vertexOf_eq`: two boundary halfedges with the same tail vertex are
  equal; so `Gluing.boundaryCount_le_one`: **`b_v ≤ 1`**, where `boundaryCount v` (of
  `DdgProofs/Delaunay/Termination.lean`) counts the boundary halfedges whose tail is `v`.
* `Gluing.boundaryInCount_le_one`: at most one boundary halfedge *ends* at `v`, and
  `Gluing.boundaryInCount_eq_boundaryCount`: the same number of boundary halfedges begins and ends
  at every vertex (on finitely many faces) — the boundary of the surface passes through a
  boundary vertex exactly once, coming in and going out.
* `Gluing.boundaryCount_eq_one_iff`, `boundaryCount_eq_zero_iff`: `b_v = 1` exactly at the
  boundary vertices (`IsBoundaryVertex`: some boundary halfedge leaves `v`, equivalently the fan
  around `v` is open), `b_v = 0` at the interior vertices.
* **Gauss–Bonnet with boundary in the familiar form** (`Gluing.IsMetric.gauss_bonnet_boundary`):
  `Σ_{v interior} (2π − Θ_v) + Σ_{v on the boundary} (π − Θ_v) = 2π χ`
  (Bobenko–Springborn 2007, Sec. 2; Crane, *Discrete Differential Geometry: An Applied
  Introduction*, 2020, Sec. 5.5; the form of `TriMesh.gauss_bonnet` in `GaussBonnet.lean`).

The general fact used is `FunctionalRel.reflTransGen_of_eqvGen_of_functional`: for a functional
relation `r`, every element equivalent (under `EqvGen r`) to an element without an `r`-successor
reaches it by forward steps.
-/

namespace DDG.Delaunay

open Real

/-! ## Functional relations: a class contains at most one end -/

namespace FunctionalRel

variable {α : Type*} {r : α → α → Prop}

/-- For a **functional** relation `r` (at most one successor), if `x` has no successor, then
everything `EqvGen r`-equivalent to `x` reaches `x` by forward `r`-steps. (The set of elements
that reach `x` is closed under `r` in both directions: backwards trivially, forwards because the
successor is unique and `x` itself has none.) -/
theorem reflTransGen_of_eqvGen_of_functional (hf : ∀ a b c, r a b → r a c → b = c) {x : α}
    (hx : ∀ z, ¬ r x z) {y : α} (h : _root_.Relation.EqvGen r y x) :
    _root_.Relation.ReflTransGen r y x := by
  have key : ∀ a b, _root_.Relation.EqvGen r a b →
      (_root_.Relation.ReflTransGen r a x ↔ _root_.Relation.ReflTransGen r b x) := by
    intro a b hab
    induction hab with
    | rel a b hr =>
      constructor
      · intro ha
        rcases ha.cases_head with rfl | ⟨c, hac, hc⟩
        · exact absurd hr (hx b)
        · rwa [hf a b c hr hac]
      · intro hb
        exact _root_.Relation.ReflTransGen.head hr hb
    | refl => exact Iff.rfl
    | symm a b _ ih => exact ih.symm
    | trans a b c _ _ ih1 ih2 => exact ih1.trans ih2
  exact (key y x h).2 _root_.Relation.ReflTransGen.refl

/-- For a functional relation, two elements without successor in the same `EqvGen` class are
equal. -/
theorem eq_of_eqvGen_of_functional (hf : ∀ a b c, r a b → r a c → b = c) {x y : α}
    (hx : ∀ z, ¬ r x z) (hy : ∀ z, ¬ r y z) (h : _root_.Relation.EqvGen r y x) : y = x := by
  rcases (reflTransGen_of_eqvGen_of_functional hf hx h).cases_head with h | ⟨c, hc, -⟩
  · exact h
  · exact absurd hc (hy c)

/-- `EqvGen` of the converse relation is `EqvGen` of the relation. -/
theorem eqvGen_flip_iff {a b : α} :
    _root_.Relation.EqvGen (fun x y => r y x) a b ↔ _root_.Relation.EqvGen r a b := by
  have h : ∀ {s s' : α → α → Prop}, (∀ x y, s x y → _root_.Relation.EqvGen s' x y) →
      ∀ {a b}, _root_.Relation.EqvGen s a b → _root_.Relation.EqvGen s' a b := by
    intro s s' hs a b hab
    induction hab with
    | rel x y hr => exact hs x y hr
    | refl => exact _root_.Relation.EqvGen.refl _
    | symm x y _ ih => exact _root_.Relation.EqvGen.symm _ _ ih
    | trans x y z _ _ ih1 ih2 => exact _root_.Relation.EqvGen.trans _ _ _ ih1 ih2
  constructor
  · exact h (s := fun x y => r y x) fun x y hr => _root_.Relation.EqvGen.symm _ _
      (_root_.Relation.EqvGen.rel _ _ hr)
  · exact h fun x y hr => _root_.Relation.EqvGen.symm _ _ (_root_.Relation.EqvGen.rel _ _ hr)

end FunctionalRel

namespace Gluing

variable {F : Type*} (G : Gluing F)

/-! ## `Glued` is an injective partial map -/

/-- `Glued` is functional: the next corner around a vertex is unique. -/
theorem glued_functional {x y z : Halfedge F} (hy : G.Glued x y) (hz : G.Glued x z) : y = z :=
  hy.2.trans hz.2.symm

/-- `Glued` is injective: the previous corner around a vertex is unique. -/
theorem glued_injective {x y z : Halfedge F} (hx : G.Glued x z) (hy : G.Glued y z) : x = y := by
  have := hx.2.symm.trans hy.2
  exact G.twin_injective (Halfedge.next_injective this)

/-- A boundary halfedge has no next corner: it is the last corner of its fan. -/
theorem not_glued_of_isBoundary {x : Halfedge F} (hx : G.twin x = x) (y : Halfedge F) :
    ¬ G.Glued x y := fun h => h.1 hx

/-- The corner `x` has a previous corner around its vertex exactly when the side `prev x` (the side
ending at the corner `x`) is glued; the previous corner is then `twin (prev x)`. -/
theorem exists_glued_iff (x : Halfedge F) : (∃ y, G.Glued y x) ↔ G.twin x.prev ≠ x.prev := by
  constructor
  · rintro ⟨y, hy, rfl⟩
    rw [Halfedge.prev_next, G.twin_twin]
    exact fun h => hy h.symm
  · intro h
    refine ⟨G.twin x.prev, ?_, ?_⟩
    · rw [G.twin_twin]; exact fun e => h e.symm
    · rw [G.twin_twin, Halfedge.next_prev]

/-! ## At most one boundary halfedge at a vertex -/

/-- **Two boundary halfedges with the same tail vertex are equal.** -/
theorem eq_of_isBoundary_of_vertexOf_eq {x y : Halfedge F} (hx : G.twin x = x)
    (hy : G.twin y = y) (h : G.vertexOf x = G.vertexOf y) : x = y :=
  FunctionalRel.eq_of_eqvGen_of_functional (r := G.Glued) (x := y) (y := x)
    (fun _ _ _ hb hc => G.glued_functional hb hc)
    (G.not_glued_of_isBoundary hy) (G.not_glued_of_isBoundary hx)
    (G.vertexOf_eq_vertexOf.1 h)

/-- **Two boundary halfedges with the same head vertex are equal.** (The corners `x.next`,
`y.next` have no previous corner; apply the uniqueness of ends to the converse relation.) -/
theorem eq_of_isBoundary_of_vertexOf_next_eq {x y : Halfedge F} (hx : G.twin x = x)
    (hy : G.twin y = y) (h : G.vertexOf x.next = G.vertexOf y.next) : x = y := by
  have hs : ∀ z : Halfedge F, G.twin z = z → ∀ w, ¬ (fun a b => G.Glued b a) z.next w := by
    intro z hz w hw
    have : ∃ y, G.Glued y z.next := ⟨w, hw⟩
    rw [G.exists_glued_iff, Halfedge.prev_next] at this
    exact this hz
  have e := FunctionalRel.eq_of_eqvGen_of_functional (r := fun a b => G.Glued b a)
    (fun a b c hb hc => G.glued_injective hb hc) (hs y hy) (hs x hx)
    (FunctionalRel.eqvGen_flip_iff.2 (G.vertexOf_eq_vertexOf.1 h))
  exact Halfedge.next_injective e

variable [Fintype F] [DecidableEq F]

/-- **At most one boundary halfedge leaves a vertex**: `b_v ≤ 1`.

[formula: complex-boundary-fan] -/
theorem boundaryCount_le_one (v : G.Vertex) : G.boundaryCount v ≤ 1 := by
  rw [boundaryCount, Finset.card_le_one]
  intro a ha b hb
  simp only [Finset.mem_filter, Finset.mem_univ, true_and] at ha hb
  exact G.eq_of_isBoundary_of_vertexOf_eq ha.1 hb.1 (ha.2.trans hb.2.symm)

/-- The number of boundary halfedges whose **head** is the vertex `v`. -/
noncomputable def boundaryInCount (v : G.Vertex) : ℕ :=
  (Finset.univ.filter fun h : Halfedge F => G.twin h = h ∧ G.vertexOf h.next = v).card

/-- At most one boundary halfedge ends at a vertex. -/
theorem boundaryInCount_le_one (v : G.Vertex) : G.boundaryInCount v ≤ 1 := by
  rw [boundaryInCount, Finset.card_le_one]
  intro a ha b hb
  simp only [Finset.mem_filter, Finset.mem_univ, true_and] at ha hb
  exact G.eq_of_isBoundary_of_vertexOf_next_eq ha.1 hb.1 (ha.2.trans hb.2.symm)

/-- **As many boundary halfedges end at a vertex as begin there.** Within the fan of `v` the map
`x ↦ next (twin x)` is a bijection from the corners that have a next corner to the corners that
have a previous one; the remaining corners are the last one (a boundary halfedge leaving `v`) and
the first one (the corner after a boundary halfedge entering `v`).

[formula: complex-boundary-fan] -/
theorem boundaryInCount_eq_boundaryCount (v : G.Vertex) :
    G.boundaryInCount v = G.boundaryCount v := by
  classical
  set C := Finset.univ.filter fun h : Halfedge F => G.vertexOf h = v
  -- the last corners and the others
  have hE : G.boundaryCount v + (C.filter fun x => G.twin x ≠ x).card = C.card := by
    rw [← Finset.card_filter_add_card_filter_not (s := C) (fun x => G.twin x = x)]
    congr 1
    rw [boundaryCount]; congr 1; ext x
    simp only [C, Finset.mem_filter, Finset.mem_univ, true_and]; exact and_comm
  -- the first corners and the others
  have hS : G.boundaryInCount v + (C.filter fun x => G.twin x.prev ≠ x.prev).card = C.card := by
    rw [← Finset.card_filter_add_card_filter_not (s := C) (fun x => G.twin x.prev = x.prev)]
    congr 1
    rw [boundaryInCount]
    refine Finset.card_nbij' Halfedge.next Halfedge.prev ?_ ?_ ?_ ?_
    · intro x hx
      simp only [Finset.coe_filter, Finset.mem_univ, true_and, Set.mem_ofPred_eq, C,
        Finset.mem_filter] at hx ⊢
      rw [Halfedge.prev_next]; exact ⟨hx.2, hx.1⟩
    · intro x hx
      simp only [Finset.coe_filter, Finset.mem_univ, true_and, Set.mem_ofPred_eq, C,
        Finset.mem_filter] at hx ⊢
      rw [Halfedge.next_prev]; exact ⟨hx.2, hx.1⟩
    · intro x _; exact Halfedge.prev_next x
    · intro x _; exact Halfedge.next_prev x
  -- the step around the vertex is a bijection between the two "others"
  have hB : (C.filter fun x => G.twin x ≠ x).card =
      (C.filter fun x => G.twin x.prev ≠ x.prev).card := by
    refine Finset.card_nbij' (fun x => (G.twin x).next) (fun y => G.twin y.prev) ?_ ?_ ?_ ?_
    · intro x hx
      simp only [Finset.coe_filter, Finset.mem_univ, true_and, Set.mem_ofPred_eq, C,
        Finset.mem_filter] at hx ⊢
      refine ⟨?_, ?_⟩
      · rw [G.vertexOf_next_twin hx.2]; exact hx.1
      · rw [Halfedge.prev_next, G.twin_twin]
        exact fun h => hx.2 h.symm
    · intro y hy
      simp only [Finset.coe_filter, Finset.mem_univ, true_and, Set.mem_ofPred_eq, C,
        Finset.mem_filter] at hy ⊢
      have hg : G.Glued (G.twin y.prev) y := by
        refine ⟨?_, ?_⟩
        · rw [G.twin_twin]; exact fun e => hy.2 e.symm
        · rw [G.twin_twin, Halfedge.next_prev]
      refine ⟨(G.vertexOf_eq_of_glued hg).trans hy.1, hg.1⟩
    · intro x _
      simp only [Halfedge.prev_next, G.twin_twin]
    · intro y _
      simp only [G.twin_twin, Halfedge.next_prev]
  omega

/-- `v` is a **boundary vertex**: some boundary halfedge leaves it (equivalently, the fan of
corners around `v` is open, `boundaryInCount_eq_boundaryCount`). -/
def IsBoundaryVertex (v : G.Vertex) : Prop := ∃ h, G.twin h = h ∧ G.vertexOf h = v

theorem boundaryCount_eq_one_iff (v : G.Vertex) : G.boundaryCount v = 1 ↔ G.IsBoundaryVertex v := by
  constructor
  · intro h
    obtain ⟨x, hx⟩ := Finset.card_eq_one.1 h
    have : x ∈ Finset.univ.filter fun h : Halfedge F => G.twin h = h ∧ G.vertexOf h = v := by
      rw [hx]; exact Finset.mem_singleton_self x
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at this
    exact ⟨x, this⟩
  · rintro ⟨x, hx⟩
    refine le_antisymm (G.boundaryCount_le_one v) (Finset.card_pos.2 ⟨x, ?_⟩)
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    exact hx

theorem boundaryCount_eq_zero_iff (v : G.Vertex) :
    G.boundaryCount v = 0 ↔ ¬ G.IsBoundaryVertex v := by
  rw [← G.boundaryCount_eq_one_iff]
  have := G.boundaryCount_le_one v
  omega

/-- **Discrete Gauss–Bonnet with boundary**, in the familiar form:
`Σ_{v interior} (2π − Θ_v) + Σ_{v on the boundary} (π − Θ_v) = 2π χ`. It is
`IsMetric.gauss_bonnet` (`Σ_v (2π − π b_v − Θ_v) = 2π χ`) with `b_v ∈ {0, 1}`
(`boundaryCount_le_one`).

[formula: complex-boundary-fan] -/
theorem IsMetric.gauss_bonnet_boundary [DecidablePred G.IsBoundaryVertex] {ℓ : Halfedge F → ℝ}
    (hm : G.IsMetric ℓ) :
    (∑ v ∈ Finset.univ.filter (fun v => ¬ G.IsBoundaryVertex v), (2 * π - G.coneAngle ℓ v)) +
      ∑ v ∈ Finset.univ.filter (fun v => G.IsBoundaryVertex v), (π - G.coneAngle ℓ v) =
      2 * π * G.eulerChar := by
  classical
  rw [← hm.gauss_bonnet, ← Finset.sum_filter_not_add_sum_filter Finset.univ
    (fun v => G.IsBoundaryVertex v)]
  congr 1
  · refine Finset.sum_congr rfl fun v hv => ?_
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hv
    rw [(G.boundaryCount_eq_zero_iff v).2 hv]
    simp
  · refine Finset.sum_congr rfl fun v hv => ?_
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hv
    rw [(G.boundaryCount_eq_one_iff v).2 hv]
    ring

end Gluing

end DDG.Delaunay
