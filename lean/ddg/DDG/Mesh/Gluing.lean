/-!
# Triangulated surfaces as gluing data

A triangulation of a surface in which two edges may join the same two vertices, an edge may join
a vertex to itself and a triangle may be glued to itself — the triangulations that intrinsic
Delaunay flipping produces (Sharp, Soliman, Crane, *Navigating Intrinsic Triangulations*, ACM TOG
38(4), 2019, Sec. 2.1, Fig. 6; Fisher, Springborn, Bobenko, Schröder, *An algorithm for the
construction of intrinsic Delaunay triangulations with applications to digital geometry
processing*, Computing 81, 2007, Sec. 2; Bobenko, Springborn, *A discrete Laplace–Beltrami
operator for simplicial surfaces*, DCG 38, 2007, Sec. 2) — is a *Δ-complex* in the sense of
Hatcher (*Algebraic Topology*, 2002, Sec. 2.1): finitely many triangles, glued pairwise along
their sides; the vertices are whatever the gluing of the sides identifies.

## The model

* The faces are a type `F`. The **halfedge** `(f, k) : F × Fin 3` is the side of face `f` from its
  corner `k` to its corner `k + 1`; it also names the corner `k` (the corner at its tail).
  `next`, `prev` are `k ↦ k ± 1` in the same face. This is the numbering `h = 3f + k` of the Rust
  complex (`crates/ddg-intrinsic/src/complex.rs`, `next`, `prev`).
* **Gluing data** (`Gluing F`) is one map, `twin`, an involution of the halfedges. A halfedge with
  `twin h ≠ h` is glued to `twin h`, traversed in the opposite direction (so the surface is
  oriented by construction: every face is a positively oriented triangle and every gluing
  reverses the direction of the side). A fixed point `twin h = h` is a **boundary** halfedge: the
  Rust `twin[h] = NONE`. A closed surface is a fixed-point-free involution (`Closed`).
* **Edges** are the orbits `{h, twin h}` of `twin` (`Edge`); a boundary edge has one halfedge.
* **Vertices** are the classes of corners under the equivalence relation generated by
  `Glued x y`: `x` is glued (`twin x ≠ x`) and `y = next (twin x)`. Then the tail of `x` is the
  head of `twin x`, which is the tail of `y`: the corners `x` and `y` are consecutive around their
  vertex (`y` is the next corner clockwise; Rust's counter-clockwise step is the inverse,
  `x ↦ twin (prev x)`). This is exactly Hatcher's identification of vertices by the gluing of the
  sides, and it is why vertices are *derived*, not given.

**Why vertices are derived.** Carrying vertex labels with consistency axioms (as Rust does in
`faces`) leaves open whether one label names one cone point or several (two fans pinched
together). Deriving the vertices from the gluing makes "the number of vertices" the topological
one, so `χ = V − E + F` is the Euler characteristic of the glued surface, and flips must be shown
to biject the vertex classes — which is where coincident vertices need care. Labels are recovered
as `Labeling`: a map `lab` from corners to a type `V` that is constant on the classes
(`IsLabeling`). It is **faithful** when equal labels mean the same class (Rust `Complex::check`:
"the corners of every vertex form one fan") and **onto** when every label is used (every Rust
vertex has an outgoing halfedge); then `V ≃ Vertex` (`Labeling.vertexEquiv`), so the Rust vertex
count is the topological one.

Everything that may occur in an intrinsic triangulation is allowed: self-loops, multiple edges,
faces glued to themselves (`twin (f, 0) = (f, 1)`), vertices with a single corner.

## Main results

* `two_mul_numEdges`: `2E = 3F + B`, `B` the number of boundary halfedges; on a closed surface
  `2E = 3F` (`two_mul_numEdges_of_closed`).
* `Labeling.numVertices_eq`: a faithful onto labelling by `V` has `|V|` vertices.
* `Iso`: a relabelling of the faces with a rotation of each face that carries one twin map to the
  other; it preserves `V`, `E`, `F` and `χ` (`Iso.eulerChar_eq`).

The edge flip and its invariants are in `DDG/Mesh/GluingFlip.lean`, edge lengths, corner and
cone angles in `DDG/Delaunay/Metric.lean`, the simplicial `TriMesh` of
`DDG/Mesh/GaussBonnet.lean` as gluing data in `DDG/Delaunay/FromTriMesh.lean`.
-/

namespace DDG.Delaunay

/-! ## Quotients: an equivalence from maps in both directions -/

section QuotientEquiv

variable {α β : Type*}

/-- An equivalence of quotients from maps both ways that respect the relations and are inverse
to each other up to the relations. -/
def quotientEquivOfMaps (s : Setoid α) (t : Setoid β) (c : α → β) (d : β → α)
    (hc : ∀ x y, s x y → t (c x) (c y)) (hd : ∀ x y, t x y → s (d x) (d y))
    (hdc : ∀ x, s (d (c x)) x) (hcd : ∀ y, t (c (d y)) y) : Quotient s ≃ Quotient t where
  toFun := Quotient.map c hc
  invFun := Quotient.map d hd
  left_inv q := by
    induction q using Quotient.inductionOn with
    | h x => exact Quotient.sound (hdc x)
  right_inv q := by
    induction q using Quotient.inductionOn with
    | h y => exact Quotient.sound (hcd y)

@[simp] theorem quotientEquivOfMaps_mk (s : Setoid α) (t : Setoid β) (c : α → β) (d : β → α)
    (hc hd hdc hcd) (x : α) :
    quotientEquivOfMaps s t c d hc hd hdc hcd (Quotient.mk s x) = Quotient.mk t (c x) := rfl

/-- To map an equivalence closure into another, it suffices to map the generators. -/
theorem eqvGen_map {r : α → α → Prop} {r' : β → β → Prop} (c : α → β)
    (h : ∀ x y, r x y → Relation.EqvGen r' (c x) (c y)) {x y : α} (hxy : Relation.EqvGen r x y) :
    Relation.EqvGen r' (c x) (c y) := by
  induction hxy with
  | rel x y hr => exact h x y hr
  | refl x => exact Relation.EqvGen.refl _
  | symm x y _ ih => exact Relation.EqvGen.symm _ _ ih
  | trans x y z _ _ ih1 ih2 => exact Relation.EqvGen.trans _ _ _ ih1 ih2

end QuotientEquiv

/-! ## Halfedges -/

/-- The halfedge `(f, k)`: the side of face `f` from its corner `k` to its corner `k + 1`, and the
corner `k` of `f`. Rust id `3f + k`. -/
abbrev Halfedge (F : Type*) := F × Fin 3

namespace Halfedge

variable {F : Type*}

/-- The next halfedge in the same face (Rust `next`). -/
def next (h : Halfedge F) : Halfedge F := (h.1, h.2 + 1)

/-- The previous halfedge in the same face (Rust `prev`). -/
def prev (h : Halfedge F) : Halfedge F := (h.1, h.2 + 2)

@[simp] theorem next_fst (h : Halfedge F) : h.next.1 = h.1 := rfl
@[simp] theorem prev_fst (h : Halfedge F) : h.prev.1 = h.1 := rfl

@[simp] theorem next_prev (h : Halfedge F) : h.prev.next = h := by
  obtain ⟨f, k⟩ := h
  simp only [next, prev, Prod.mk.injEq, true_and]
  revert k; decide

@[simp] theorem prev_next (h : Halfedge F) : h.next.prev = h := by
  obtain ⟨f, k⟩ := h
  simp only [next, prev, Prod.mk.injEq, true_and]
  revert k; decide

@[simp] theorem next_next (h : Halfedge F) : h.next.next = h.prev := by
  obtain ⟨f, k⟩ := h
  simp only [next, prev, Prod.mk.injEq, true_and]
  revert k; decide

@[simp] theorem prev_prev (h : Halfedge F) : h.prev.prev = h.next := by
  obtain ⟨f, k⟩ := h
  simp only [next, prev, Prod.mk.injEq, true_and]
  revert k; decide

theorem next_injective : Function.Injective (next : Halfedge F → Halfedge F) := by
  intro x y h
  rw [← prev_next x, h, prev_next]

@[simp] theorem next_inj {x y : Halfedge F} : x.next = y.next ↔ x = y :=
  next_injective.eq_iff

@[simp] theorem next_ne (h : Halfedge F) : h.next ≠ h := by
  obtain ⟨f, k⟩ := h
  simp only [next, ne_eq, Prod.mk.injEq, true_and]
  revert k; decide

@[simp] theorem prev_ne (h : Halfedge F) : h.prev ≠ h := by
  obtain ⟨f, k⟩ := h
  simp only [prev, ne_eq, Prod.mk.injEq, true_and]
  revert k; decide

@[simp] theorem next_ne_prev (h : Halfedge F) : h.next ≠ h.prev := by
  obtain ⟨f, k⟩ := h
  simp only [next, prev, ne_eq, Prod.mk.injEq, true_and]
  revert k; decide

@[simp] theorem prev_ne_next (h : Halfedge F) : h.prev ≠ h.next := (next_ne_prev h).symm
@[simp] theorem ne_next (h : Halfedge F) : h ≠ h.next := (next_ne h).symm
@[simp] theorem ne_prev (h : Halfedge F) : h ≠ h.prev := (prev_ne h).symm

/-- A halfedge of the face `f` is one of `h, next h, prev h` for any halfedge `h` of `f`. -/
theorem eq_or_eq_next_or_eq_prev {h x : Halfedge F} (hx : x.1 = h.1) :
    x = h ∨ x = h.next ∨ x = h.prev := by
  obtain ⟨f, k⟩ := h
  obtain ⟨g, l⟩ := x
  simp only at hx
  subst hx
  simp only [next, prev, Prod.mk.injEq, true_and]
  revert k l
  decide

end Halfedge

/-! ## Gluing data -/

/-- **Gluing data** of a triangulated surface with faces `F`: an involution `twin` of the
halfedges. `twin h ≠ h` glues the side `h` to the side `twin h` with the opposite direction;
`twin h = h` marks a boundary halfedge (Rust `twin[h] = NONE`). -/
structure Gluing (F : Type*) where
  /-- The halfedge glued to `h`, or `h` itself on the boundary. -/
  twin : Halfedge F → Halfedge F
  twin_twin : ∀ h, twin (twin h) = h

namespace Gluing

variable {F : Type*} (G : Gluing F)

attribute [simp] twin_twin

theorem twin_injective : Function.Injective G.twin :=
  Function.LeftInverse.injective G.twin_twin

@[simp] theorem twin_inj {x y : Halfedge F} : G.twin x = G.twin y ↔ x = y :=
  G.twin_injective.eq_iff

theorem twin_eq_iff {x y : Halfedge F} : G.twin x = y ↔ x = G.twin y := by
  constructor
  · rintro rfl; simp
  · rintro rfl; simp

/-- `h` lies on the boundary: it is glued to nothing. -/
def IsBoundary (h : Halfedge F) : Prop := G.twin h = h

/-- A closed surface: no halfedge lies on the boundary. -/
def Closed : Prop := ∀ h, G.twin h ≠ h

/-! ### Edges -/

/-- Two halfedges are the same edge: equal or twins. -/
def edgeSetoid : Setoid (Halfedge F) where
  r x y := y = x ∨ y = G.twin x
  iseqv := by
    refine ⟨fun _ => Or.inl rfl, ?_, ?_⟩
    · rintro x y (rfl | rfl)
      · exact Or.inl rfl
      · exact Or.inr (G.twin_twin x).symm
    · rintro x y z (rfl | rfl) (rfl | rfl)
      · exact Or.inl rfl
      · exact Or.inr rfl
      · exact Or.inr rfl
      · exact Or.inl (G.twin_twin x)

theorem edgeSetoid_r {x y : Halfedge F} : G.edgeSetoid x y ↔ y = x ∨ y = G.twin x := Iff.rfl

/-- The edges: orbits `{h, twin h}`. -/
def Edge : Type _ := Quotient G.edgeSetoid

/-- The edge of a halfedge. -/
def edgeOf (h : Halfedge F) : G.Edge := Quotient.mk G.edgeSetoid h

theorem edgeOf_eq_edgeOf {x y : Halfedge F} : G.edgeOf x = G.edgeOf y ↔ y = x ∨ y = G.twin x :=
  Quotient.eq

@[simp] theorem edgeOf_twin (h : Halfedge F) : G.edgeOf (G.twin h) = G.edgeOf h :=
  (G.edgeOf_eq_edgeOf).2 (Or.inr (G.twin_twin h).symm)

/-! ### Vertices -/

/-- The generating relation of the vertices: `x` is glued and `y = next (twin x)`, so the tail of
`x` is the head of `twin x`, the tail of `y`. -/
def Glued (x y : Halfedge F) : Prop := G.twin x ≠ x ∧ y = (G.twin x).next

/-- Two corners lie at the same vertex: the equivalence relation generated by `Glued`. -/
def vertexSetoid : Setoid (Halfedge F) := Relation.EqvGen.setoid G.Glued

/-- The vertices: classes of corners. -/
def Vertex : Type _ := Quotient G.vertexSetoid

/-- The vertex of a corner, i.e. the tail of a halfedge. -/
def vertexOf (h : Halfedge F) : G.Vertex := Quotient.mk G.vertexSetoid h

theorem vertexOf_eq_vertexOf {x y : Halfedge F} :
    G.vertexOf x = G.vertexOf y ↔ Relation.EqvGen G.Glued x y :=
  Quotient.eq

theorem vertexOf_eq_of_glued {x y : Halfedge F} (h : G.Glued x y) : G.vertexOf x = G.vertexOf y :=
  G.vertexOf_eq_vertexOf.2 (Relation.EqvGen.rel _ _ h)

/-- The tail of a glued halfedge is the head of its twin. -/
theorem vertexOf_next_twin {h : Halfedge F} (hb : G.twin h ≠ h) :
    G.vertexOf (G.twin h).next = G.vertexOf h :=
  (G.vertexOf_eq_of_glued ⟨hb, rfl⟩).symm

/-- The head of a glued halfedge is the tail of its twin. -/
theorem vertexOf_twin {h : Halfedge F} (hb : G.twin h ≠ h) :
    G.vertexOf (G.twin h) = G.vertexOf h.next := by
  have hb' : G.twin (G.twin h) ≠ G.twin h := by rw [G.twin_twin]; exact fun e => hb e.symm
  have := G.vertexOf_next_twin hb'
  rw [G.twin_twin] at this
  exact this.symm

/-! ### Counts and the Euler characteristic -/

instance [Finite F] : Finite G.Edge := Quotient.finite _
instance [Finite F] : Finite G.Vertex := Quotient.finite _
noncomputable instance [Finite F] : Fintype G.Edge := Fintype.ofFinite _
noncomputable instance [Finite F] : Fintype G.Vertex := Fintype.ofFinite _
noncomputable instance : DecidableEq G.Vertex := Classical.decEq _
noncomputable instance : DecidableEq G.Edge := Classical.decEq _

/-- Number of vertices. -/
noncomputable def numVertices : ℕ := Nat.card G.Vertex

/-- Number of edges. -/
noncomputable def numEdges : ℕ := Nat.card G.Edge

/-- **Euler characteristic** `χ = V − E + F` of the glued surface (Rust
`Complex::euler_characteristic`).

[formula: it-complex-euler] -/
noncomputable def eulerChar [Fintype F] : ℤ :=
  (G.numVertices : ℤ) - (G.numEdges : ℤ) + (Fintype.card F : ℤ)

/-- Number of boundary halfedges (= number of boundary edges). -/
def numBoundary [Fintype F] [DecidableEq F] : ℕ :=
  (Finset.univ.filter fun h : Halfedge F => G.twin h = h).card

/-- **Edges and faces**: `2E = 3F + B`, with `B` the number of boundary halfedges (every interior
edge has two halfedges, every boundary edge one, every face three).

[formula: it-complex-euler] -/
theorem two_mul_numEdges [Fintype F] [DecidableEq F] :
    2 * G.numEdges = 3 * Fintype.card F + G.numBoundary := by
  classical
  set B := Finset.univ.filter fun h : Halfedge F => G.twin h = h
  have hfib : ∀ x : Halfedge F, (Finset.univ.filter fun h => G.edgeOf h = G.edgeOf x) =
      {x, G.twin x} := by
    intro x
    ext h
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_insert,
      Finset.mem_singleton, G.edgeOf_eq_edgeOf]
    constructor
    · rintro (h1 | h1)
      · exact Or.inl h1.symm
      · rw [h1, G.twin_twin]; exact Or.inr rfl
    · rintro (rfl | rfl)
      · exact Or.inl rfl
      · exact Or.inr (G.twin_twin x).symm
  have key : ∀ e : G.Edge, (Finset.univ.filter fun h => G.edgeOf h = e).card +
      (B.filter fun h => G.edgeOf h = e).card = 2 := by
    intro e
    induction e using Quotient.inductionOn with
    | h x =>
      change (Finset.univ.filter fun h => G.edgeOf h = G.edgeOf x).card +
        (B.filter fun h => G.edgeOf h = G.edgeOf x).card = 2
      have hB : B.filter (fun h => G.edgeOf h = G.edgeOf x) =
          ({x, G.twin x} : Finset _).filter fun h => G.twin h = h := by
        rw [← hfib x, Finset.filter_filter, Finset.filter_filter]
        congr 1
        ext h
        exact and_comm
      rw [hfib x, hB]
      by_cases hb : G.twin x = x
      · rw [hb]
        simp [Finset.filter_singleton, hb]
      · have hne : x ≠ G.twin x := fun e => hb e.symm
        rw [Finset.card_pair hne]
        have : (({x, G.twin x} : Finset _).filter fun h => G.twin h = h) = ∅ := by
          ext h
          simp only [Finset.mem_filter, Finset.mem_insert, Finset.mem_singleton,
            Finset.notMem_empty, iff_false, not_and]
          rintro (rfl | rfl)
          · exact hb
          · rw [G.twin_twin]; exact hne
        rw [this, Finset.card_empty]
  have h1 := Finset.card_eq_sum_card_fiberwise (f := G.edgeOf) (s := Finset.univ)
    (t := (Finset.univ : Finset G.Edge)) (fun _ _ => Finset.mem_univ _)
  have h2 := Finset.card_eq_sum_card_fiberwise (f := G.edgeOf) (s := B)
    (t := (Finset.univ : Finset G.Edge)) (fun _ _ => Finset.mem_univ _)
  have h3 : (Finset.univ : Finset (Halfedge F)).card + B.card = 2 * Fintype.card G.Edge := by
    rw [h1, h2, ← Finset.sum_add_distrib, Finset.sum_congr rfl (fun e _ => key e)]
    simp [mul_comm]
  rw [numEdges, Nat.card_eq_fintype_card, numBoundary, ← h3]
  simp [Fintype.card_prod, mul_comm, B]

/-- On a closed surface `2E = 3F`. -/
theorem two_mul_numEdges_of_closed [Fintype F] (hc : G.Closed) :
    2 * G.numEdges = 3 * Fintype.card F := by
  classical
  have h := G.two_mul_numEdges
  have h0 : G.numBoundary = 0 := by
    rw [numBoundary, Finset.card_eq_zero, Finset.filter_eq_empty_iff]
    exact fun h _ => hc h
  omega

/-! ## Vertex labellings (the Rust `faces` array) -/

/-- A vertex labelling: two corners consecutive around a vertex carry the same label. Rust's
`faces[f][k]` is the label of the corner `(f, k)`. -/
def IsLabeling {V : Type*} (lab : Halfedge F → V) : Prop := ∀ x y, G.Glued x y → lab x = lab y

/-- A labelling is faithful when corners with the same label lie at the same vertex: every label
is one fan (Rust `Complex::check`). -/
def Faithful {V : Type*} (lab : Halfedge F → V) : Prop :=
  ∀ x y, lab x = lab y → G.vertexOf x = G.vertexOf y

namespace IsLabeling

variable {G} {V : Type*} {lab : Halfedge F → V}

theorem eq_of_eqvGen (hl : G.IsLabeling lab) {x y : Halfedge F}
    (h : Relation.EqvGen G.Glued x y) : lab x = lab y := by
  induction h with
  | rel x y hr => exact hl x y hr
  | refl x => rfl
  | symm x y _ ih => exact ih.symm
  | trans x y z _ _ ih1 ih2 => exact ih1.trans ih2

theorem eq_of_vertexOf (hl : G.IsLabeling lab) {x y : Halfedge F}
    (h : G.vertexOf x = G.vertexOf y) : lab x = lab y :=
  hl.eq_of_eqvGen (G.vertexOf_eq_vertexOf.1 h)

/-- The labels run against each other on glued sides: the tail of `twin h` is the head of `h`,
the head of `twin h` the tail of `h` (orientation of the gluing, Rust `Complex::check`: "twins run
in opposite directions"). -/
theorem twin (hl : G.IsLabeling lab) {h : Halfedge F} (hb : G.twin h ≠ h) :
    lab (G.twin h) = lab h.next ∧ lab (G.twin h).next = lab h :=
  ⟨hl.eq_of_vertexOf (G.vertexOf_twin hb), hl.eq_of_vertexOf (G.vertexOf_next_twin hb)⟩

/-- The label of a vertex. -/
def onVertex (hl : G.IsLabeling lab) : G.Vertex → V :=
  Quotient.lift lab fun _ _ h => hl.eq_of_eqvGen h

@[simp] theorem onVertex_vertexOf (hl : G.IsLabeling lab) (h : Halfedge F) :
    hl.onVertex (G.vertexOf h) = lab h := rfl

/-- **A faithful labelling onto `V` identifies `V` with the vertices.** -/
noncomputable def vertexEquiv (hl : G.IsLabeling lab) (hf : G.Faithful lab)
    (hs : Function.Surjective lab) : G.Vertex ≃ V :=
  Equiv.ofBijective hl.onVertex ⟨by
    intro p q
    induction p using Quotient.inductionOn
    induction q using Quotient.inductionOn
    exact hf _ _, by
    intro v
    obtain ⟨h, rfl⟩ := hs v
    exact ⟨G.vertexOf h, rfl⟩⟩

/-- A faithful labelling onto `V` counts the vertices: `numVertices = |V|`. -/
theorem numVertices_eq (hl : G.IsLabeling lab) (hf : G.Faithful lab)
    (hs : Function.Surjective lab) : G.numVertices = Nat.card V :=
  Nat.card_congr (hl.vertexEquiv hf hs)

end IsLabeling

/-! ## Isomorphisms of gluing data -/

/-- An **isomorphism** from `G` to `G'`: a bijection of the faces and a rotation of each face,
`(f, k) ↦ (faces f, k + shift f)`, that carries `G.twin` to `G'.twin`. -/
structure Iso {F' : Type*} (G : Gluing F) (G' : Gluing F') where
  faces : F ≃ F'
  shift : F → Fin 3
  twin_comm : ∀ h : Halfedge F,
    G'.twin (faces h.1, h.2 + shift h.1) =
      (faces (G.twin h).1, (G.twin h).2 + shift (G.twin h).1)

namespace Iso

variable {G} {F' : Type*} {G' : Gluing F'} (ψ : Iso G G')

/-- The map of halfedges. -/
def toHalfedge : Halfedge F ≃ Halfedge F' where
  toFun h := (ψ.faces h.1, h.2 + ψ.shift h.1)
  invFun h := (ψ.faces.symm h.1, h.2 - ψ.shift (ψ.faces.symm h.1))
  left_inv h := by simp
  right_inv h := by simp

@[simp] theorem toHalfedge_apply (h : Halfedge F) :
    ψ.toHalfedge h = (ψ.faces h.1, h.2 + ψ.shift h.1) := rfl

theorem toHalfedge_twin (h : Halfedge F) : ψ.toHalfedge (G.twin h) = G'.twin (ψ.toHalfedge h) :=
  (ψ.twin_comm h).symm

theorem toHalfedge_next (h : Halfedge F) : ψ.toHalfedge h.next = (ψ.toHalfedge h).next := by
  simp only [toHalfedge_apply, Halfedge.next, Prod.mk.injEq, true_and]
  exact add_right_comm _ _ _

theorem glued_iff (x y : Halfedge F) :
    G'.Glued (ψ.toHalfedge x) (ψ.toHalfedge y) ↔ G.Glued x y := by
  simp only [Glued, ← ψ.toHalfedge_twin, ← ψ.toHalfedge_next, ne_eq,
    ψ.toHalfedge.injective.eq_iff]

/-- An isomorphism maps vertices to vertices. -/
def vertexEquiv : G.Vertex ≃ G'.Vertex :=
  quotientEquivOfMaps _ _ ψ.toHalfedge ψ.toHalfedge.symm
    (fun x y h => eqvGen_map _ (fun a b hab => Relation.EqvGen.rel _ _ ((ψ.glued_iff a b).2 hab)) h)
    (fun x y h => eqvGen_map _ (fun a b hab => Relation.EqvGen.rel _ _ (by
      rw [← ψ.glued_iff]; simpa using hab)) h)
    (fun x => by rw [Equiv.symm_apply_apply])
    (fun y => by rw [Equiv.apply_symm_apply])

/-- An isomorphism maps edges to edges. -/
def edgeEquiv : G.Edge ≃ G'.Edge :=
  quotientEquivOfMaps _ _ ψ.toHalfedge ψ.toHalfedge.symm
    (by
      rintro x y (rfl | rfl)
      · exact Or.inl rfl
      · exact Or.inr (ψ.toHalfedge_twin x))
    (by
      rintro x y (rfl | rfl)
      · exact Or.inl rfl
      · right
        rw [Equiv.symm_apply_eq, ψ.toHalfedge_twin, Equiv.apply_symm_apply])
    (fun x => by simp only [Equiv.symm_apply_apply]; exact Or.inl rfl)
    (fun y => by simp only [Equiv.apply_symm_apply]; exact Or.inl rfl)

include ψ in
theorem numVertices_eq : G.numVertices = G'.numVertices := Nat.card_congr ψ.vertexEquiv
include ψ in
theorem numEdges_eq : G.numEdges = G'.numEdges := Nat.card_congr ψ.edgeEquiv

include ψ in
/-- **Isomorphic gluing data have the same Euler characteristic.** -/
theorem eulerChar_eq [Fintype F] [Fintype F'] : G.eulerChar = G'.eulerChar := by
  simp only [eulerChar, ψ.numVertices_eq, ψ.numEdges_eq, Fintype.card_congr ψ.faces]

end Iso

end Gluing

/-! ## Examples: the hypotheses are satisfiable -/

/-- One triangle, nothing glued: a disk. -/
def Gluing.triangle : Gluing Unit := ⟨id, fun _ => rfl⟩

/-- Two triangles glued along all three sides: a sphere with three vertices, three edges, two
faces (the doubled triangle): face 0 is `abc`, face 1 is `acb`, and `(0, k) ↔ (1, 2 − k)`. -/
def Gluing.doubleTriangle : Gluing (Fin 2) where
  twin h := (h.1 + 1, 2 - h.2)
  twin_twin h := by
    obtain ⟨f, k⟩ := h
    simp only [Prod.mk.injEq]
    constructor
    · revert f; decide
    · revert k; decide

/-- The doubled triangle is closed. -/
example : Gluing.doubleTriangle.Closed := by
  rintro ⟨f, k⟩
  simp only [Gluing.doubleTriangle, ne_eq, Prod.mk.injEq]
  revert f k; decide

end DDG.Delaunay
