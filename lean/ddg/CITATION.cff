cff-version: 1.2.0
message: "If you use this library, please cite it as below, and cite the papers whose formulas you use (see README.md, section References)."
title: "DDG: a formally verified library of discrete differential geometry"
abstract: "A Lean 4 / Mathlib library of machine-checked theorems of discrete differential geometry (triangle meshes, the cotan Laplacian, intrinsic triangulations, Delaunay triangulations, discrete conformal geometry, normal coordinates, repulsive energies, signed distance functions), organised in 14 separately buildable parts."
type: software
version: 0.1.0
license: MIT
authors:
  - family-names: "Malovitsa"
    given-names: "Igor"
    email: "igor.malovitsa@gmail.com"
keywords:
  - "discrete differential geometry"
  - "Lean 4"
  - "Mathlib"
  - "formal verification"
  - "Delaunay triangulation"
  - "intrinsic triangulations"
